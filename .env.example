# Copy these names into the environment-variable section of your hosting
# service. Do not put real passwords or secret keys in this file.

DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=your-app-hostname.example.com
CSRF_TRUSTED_ORIGINS=https://your-app-hostname.example.com
PUBLIC_BASE_URL=https://your-app-hostname.example.com

# Enable this after the hosting service has issued HTTPS successfully.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Production email example. Replace the values with those from your provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Event Management System <noreply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=15

# Brevo HTTPS API (recommended for PythonAnywhere free accounts).
EMAIL_BACKEND=config.email_backends.BrevoEmailBackend
BREVO_API_KEY=replace-with-private-brevo-api-key
BREVO_TIMEOUT=15

# Private bearer token used by the external reminder scheduler.
REMINDER_SCHEDULER_TOKEN=replace-with-a-long-random-token
